# Copy to .env and change every value.

# Password of the first administrator (user name: admin). At least 10 characters.
ADMIN_PASSWORD=change-me-admin
# Tenant used when no other tenant is resolved. Empty for multi-tenant hosting.
DEFAULT_TENANT=default
PAPERDOTNET_PORT=8080

# Only needed with docker-compose.postgres.yml (not in the Native AOT build yet, ADR-0039):
# superuser for maintenance; the app itself uses the ordinary role "paperdotnet" (row-level security applies).
POSTGRES_ADMIN_PASSWORD=change-me-admin-postgres
POSTGRES_PASSWORD=change-me-postgres
