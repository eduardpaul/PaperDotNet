<Project Sdk="Microsoft.NET.Sdk">
  <!--
    The server against a real host on SQLite (JIT build). The published Native AOT binary is checked by eng/aot-smoke.sh.
    ToPort/ holds the tests of features still to port (ADR-0039); they are not compiled.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
  </PropertyGroup>
  <ItemGroup>
    <Compile Remove="ToPort/**" />
    <None Include="ToPort/**" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="xunit.v3.mtp-v2" />
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\src\PaperDotNet.Host\PaperDotNet.Host.csproj" />
  </ItemGroup>
</Project>
