# Copy to .env and change every value.

# Which parts to start:
#   npm           NPM and PaperDotNet; an NPM access list signs people in
#   npm,authelia  the same with Authelia (groups, e-mail, two-factor)
#   (empty)       only PaperDotNet, for an NPM you already run; add authelia if you want it
COMPOSE_PROFILES=npm

# Public host name of PaperDotNet (an NPM proxy host with a certificate).
PAPERDOTNET_HOST=docs.example.com

# Password of the first administrator (user name: admin). At least 10 characters.
# Behind the proxy, the proxy's user "admin" signs in as this administrator.
ADMIN_PASSWORD=change-me-admin

# Address of NPM on the network it shares with PaperDotNet. PaperDotNet trusts sign-in
# headers only from here. Must lie in PROXY_SUBNET.
NPM_IP=172.30.10.2
PROXY_SUBNET=172.30.10.0/24
NPM_ADMIN_PORT=81

# The secret NPM sends to PaperDotNet with the user's name; paste it into the Advanced config too.
# Letters and digits only, at least 16 characters, e.g. `openssl rand -hex 32`.
PROXY_SECRET=change-me-proxy-secret-0123456789abcdef

# true: people the proxy signs in get an account (Member) automatically.
CREATE_USERS=true
# Groups the proxy names: create missing ones (true), and keep memberships in them in sync
# (Sync) or only ever add members (Add).
CREATE_GROUPS=true
GROUP_SYNC=Sync
# How long a proxy sign-in lasts before the browser goes through the proxy again (d.hh:mm:ss).
PROXY_SIGN_IN_LIFETIME=1.00:00:00
# Where signing out of PaperDotNet goes afterwards; for Authelia https://auth.example.com/logout.
PROXY_LOGOUT_URL=

# Only with the authelia profile:
# Authelia's portal (a second NPM proxy host) and the domain both host names share.
AUTH_HOST=auth.example.com
COOKIE_DOMAIN=example.com
# Random secrets, e.g. `openssl rand -hex 32` for each.
AUTHELIA_SESSION_SECRET=change-me-session-secret-0123456789abcdef
AUTHELIA_STORAGE_ENCRYPTION_KEY=change-me-storage-key-0123456789abcdef
AUTHELIA_RESET_PASSWORD_JWT_SECRET=change-me-jwt-secret-0123456789abcdef
