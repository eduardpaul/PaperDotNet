{
  "$schema": "../../docs/schemas/extension-manifest.schema.json",
  "id": "samples.invoices",
  "name": "Invoices (sample)",
  "version": "1.0.0",
  "publisher": "PaperDotNet",
  "description": "Sample extension: IBAN field type, approval rules and approval records for invoices, stats endpoint and a recurring job.",
  "sdkVersion": "1.0",
  "autoEnable": false,
  "scopes": [
    { "name": "samples.invoices.read", "description": "See invoice statistics.", "grantedToMembers": true },
    { "name": "samples.invoices.approve", "description": "Approve invoices above the threshold." }
  ],
  "settings": [
    { "name": "approvalThreshold", "type": "number", "description": "Invoices above this amount need approval.", "default": 1000 },
    { "name": "currency", "type": "choice", "choices": ["EUR", "USD"], "default": "EUR" },
    { "name": "requireApproval", "type": "boolean", "default": true }
  ]
}
