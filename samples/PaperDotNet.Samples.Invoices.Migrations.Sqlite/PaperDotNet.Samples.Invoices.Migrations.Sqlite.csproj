<Project Sdk="Microsoft.NET.Sdk">
  <!--
    Sqlite migrations of the sample extension's own tables (EXT-07). The host references this
    assembly next to the extension; the runtime finds it by name ({extension assembly}.Migrations.Sqlite).
    Add a migration:  dotnet ef migrations add <Name> -p samples/PaperDotNet.Samples.Invoices.Migrations.Sqlite -c InvoicesDbContext -o Generated
  -->
  <ItemGroup>
    <ProjectReference Include="..\PaperDotNet.Samples.Invoices\PaperDotNet.Samples.Invoices.csproj" />
    <ProjectReference Include="..\..\src\BuildingBlocks\PaperDotNet.Persistence.Sqlite\PaperDotNet.Persistence.Sqlite.csproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" PrivateAssets="all" />
  </ItemGroup>
</Project>
