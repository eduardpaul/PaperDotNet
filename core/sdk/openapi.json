  "components": {
    "schemas": {
      "AuditEntryDto": {
        "required": [
          "id",
          "action",
          "targetId",
          "listId",
          "userId",
          "summary",
          "occurredAt"
        ],
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "action": {
            "type": "string"
          },
          "targetId": {
            "type": "string",
            "format": "uuid"
          },
          "listId": {
            "type": [
              "null",
              "string"
            ],
            "format": "uuid"
          },
          "userId": {
            "type": [
              "null",
              "string"
            ],
            "format": "uuid"
          },
          "summary": {
            "type": [
              "null",
              "string"
            ]
          },
          "occurredAt": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "CreateItemRequest": {
        "required": [
          "fields"
        ],
        "type": "object",
        "properties": {
          "fields": {
            "$ref": "#/components/schemas/JsonObject"
          }
        },
        "description": "New item: `fields` holds the title and the other field values."
      },
      "CreateListRequest": {
        "required": [
          "name",
          "description",
          "fields"
        ],
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "description": {
            "type": [
              "null",
              "string"
            ]
          },
          "fields": {
            "type": [
              "null",
              "array"
            ],
            "items": {
              "$ref": "#/components/schemas/FieldDefinition"
            }
          }
        }
      },
      "CreateUserRequest": {
        "required": [
          "userName",
          "password",
          "displayName"
        ],
        "type": "object",
        "properties": {
          "userName": {
            "type": "string"
          },
          "password": {
            "type": "string"
          },
          "displayName": {
            "type": [
              "null",
              "string"
            ]
          },
          "isAdmin": {
            "type": "boolean",
            "default": false
          }
        }
      },
      "FieldDefinition": {
        "required": [
          "name",
          "type"
        ],
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "type": {
            "type": "string"
          },
          "required": {
            "type": "boolean",
            "default": false
          },
          "choices": {
            "type": [
              "null",
              "array"
            ],
            "items": {
              "type": "string"
            }
          },
          "displayName": {
            "type": [
              "null",
              "string"
            ]
          }
        },
        "description": "A field of a list. string FieldDefinition.Name is the key in item `fields` and in `$filter` (`fields/name`)."
      },
      "HttpValidationProblemDetails": {
        "type": "object",
        "properties": {
          "type": {
            "type": [
              "null",
              "string"
            ]
          },
          "title": {
            "type": [
              "null",
              "string"
            ]
          },
          "status": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "null",
              "integer",
              "string"
            ],
            "format": "int32"
          },
          "detail": {
            "type": [
              "null",
              "string"
            ]
          },
          "instance": {
            "type": [
              "null",
              "string"
            ]
          },
          "errors": {
            "type": "object",
            "additionalProperties": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          }
        }
      },
      "ItemDto": {
        "required": [
          "id",
          "listId",
          "fields",
          "createdAt",
          "createdBy",
          "updatedAt",
          "updatedBy",
          "@odata.etag"
        ],
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "listId": {
            "type": "string",
            "format": "uuid"
          },
          "fields": {
            "$ref": "#/components/schemas/JsonObject"
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          },
          "createdBy": {
            "type": [
              "null",
              "string"
            ],
            "format": "uuid"
          },
          "updatedAt": {
            "type": "string",
            "format": "date-time"
          },
          "updatedBy": {
            "type": [
              "null",
              "string"
            ],
            "format": "uuid"
          },
          "@odata.etag": {
            "type": "string"
          }
        }
      },
      "JsonObject": {
        "type": "object"
      },
      "ListDto": {
        "required": [
          "id",
          "name",
          "description",
          "fields",
          "createdAt",
          "createdBy",
          "updatedAt",
          "updatedBy",
          "@odata.etag"
        ],
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "name": {
            "type": "string"
          },
          "description": {
            "type": [
              "null",
              "string"
            ]
          },
          "fields": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/FieldDefinition"
            }
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          },
          "createdBy": {
            "type": [
              "null",
              "string"
            ],
            "format": "uuid"
          },
          "updatedAt": {
            "type": "string",
            "format": "date-time"
          },
          "updatedBy": {
            "type": [
              "null",
              "string"
            ],
            "format": "uuid"
          },
          "@odata.etag": {
            "type": "string"
          }
        }
      },
      "MeDto": {
        "required": [
          "id",
          "tenantId",
          "userName",
          "displayName",
          "isAdmin",
          "scopes"
        ],
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "tenantId": {
            "type": "string",
            "format": "uuid"
          },
          "userName": {
            "type": "string"
          },
          "displayName": {
            "type": "string"
          },
          "isAdmin": {
            "type": "boolean"
          },
          "scopes": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      },
      "PageOfAuditEntryDto": {
        "required": [
          "value",
          "@odata.nextLink"
        ],
        "type": "object",
        "properties": {
          "value": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/AuditEntryDto"
            }
          },
          "@odata.nextLink": {
            "type": [
              "null",
              "string"
            ]
          },
          "@odata.count": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "null",
              "integer",
              "string"
            ],
            "format": "int64"
          }
        },
        "description": "A page of results in Graph/OData shape."
      },
      "PageOfItemDto": {
        "required": [
          "value",
          "@odata.nextLink"
        ],
        "type": "object",
        "properties": {
          "value": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ItemDto"
            }
          },
          "@odata.nextLink": {
            "type": [
              "null",
              "string"
            ]
          },
          "@odata.count": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "null",
              "integer",
              "string"
            ],
            "format": "int64"
          }
        },
        "description": "A page of results in Graph/OData shape."
      },
      "PageOfListDto": {
        "required": [
          "value",
          "@odata.nextLink"
        ],
        "type": "object",
        "properties": {
          "value": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ListDto"
            }
          },
          "@odata.nextLink": {
            "type": [
              "null",
              "string"
            ]
          },
          "@odata.count": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "null",
              "integer",
              "string"
            ],
            "format": "int64"
          }
        },
        "description": "A page of results in Graph/OData shape."
      },
      "PageOfUserDto": {
        "required": [
          "value",
          "@odata.nextLink"
        ],
        "type": "object",
        "properties": {
          "value": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/UserDto"
            }
          },
          "@odata.nextLink": {
            "type": [
              "null",
              "string"
            ]
          },
          "@odata.count": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "null",
              "integer",
              "string"
            ],
            "format": "int64"
          }
        },
        "description": "A page of results in Graph/OData shape."
      },
