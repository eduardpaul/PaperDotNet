<Project Sdk="Microsoft.NET.Sdk.Web">
  <!--
    The PaperDotNet server as one Native AOT binary (ADR-0039). SQLite only for now: EF Core precompiles every query
    to the SQL of one provider, so each database is its own build.

    Before publishing: `paperdotnet codegen write` (Wolverine handlers, committed under Internal/Generated) runs as
    part of eng/codegen.sh; EF Core builds the compiled model and query interceptors during publish
    (Microsoft.EntityFrameworkCore.Tasks). Schema changes: eng/schema.sh.
  -->
  <PropertyGroup>
    <AssemblyName>paperdotnet</AssemblyName>
    <RootNamespace>PaperDotNet.Core.Host</RootNamespace>
    <PublishAot>true</PublishAot>
    <!--
      PublishAot also turns dynamic code off in JIT builds, where EF Core then refuses to build its model. Development
      and test runs keep it (runtime model, LINQ compiled at run time); the published binary has the compiled model
      and precompiled queries, checked by eng/aot-smoke.sh.
    -->
    <DynamicCodeSupport Condition="'$(_IsPublishing)' != 'true'">true</DynamicCodeSupport>
    <!--
      Our code is held to the trim and AOT analyzers (warnings are errors at build). EF Core, the OData parser and
      Weasel still report trim warnings of their own (one line per assembly); those stay warnings, and the published
      binary is checked by eng/aot-smoke.sh (ADR-0039).
    -->
    <IlcTreatWarningsAsErrors>false</IlcTreatWarningsAsErrors>
    <!-- EF Core query precompilation (ADR-0039): compiled model and interceptors are generated at publish. -->
    <InterceptorsNamespaces>$(InterceptorsNamespaces);Microsoft.EntityFrameworkCore.GeneratedInterceptors</InterceptorsNamespaces>
    <EFScaffoldModelStage>publish</EFScaffoldModelStage>
    <EFPrecompileQueriesStage>publish</EFPrecompileQueriesStage>
    <!-- CS8669: EF Core's generated interceptors use nullable annotations without #nullable (only raised in generated code). -->
    <NoWarn>$(NoWarn);CS8669</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\PaperDotNet.Core\PaperDotNet.Core.csproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Tasks" PrivateAssets="all" />
    <PackageReference Include="WolverineFx.Sqlite" />
    <PackageReference Include="Microsoft.OData.Core" />
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" />
  </ItemGroup>
  <ItemGroup>
    <!-- EF Core's generated interceptors name entity types without importing their namespaces (ADR-0039). -->
    <Using Include="PaperDotNet.Core.Host.Audit" />
    <Using Include="PaperDotNet.Core.Host.Identity" />
    <Using Include="PaperDotNet.Core.Host.Lists" />
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Include="Schema\Sqlite\*.sql" LogicalName="Schema.Sqlite.%(Filename).sql" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="PaperDotNet.Core.Tests" />
    <InternalsVisibleTo Include="PaperDotNet.Core.Migrations.Sqlite" />
  </ItemGroup>
</Project>
