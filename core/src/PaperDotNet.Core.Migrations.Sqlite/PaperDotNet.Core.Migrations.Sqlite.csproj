<Project Sdk="Microsoft.NET.Sdk">
  <!--
    Design time only: EF Core migrations of CoreDb on SQLite. Not shipped: the host cannot run migrations under
    Native AOT, so eng/schema.sh turns each migration into SQL under src/PaperDotNet.Core.Host/Schema/Sqlite (ADR-0039).
  -->
  <PropertyGroup>
    <!-- Generated migrations: our style rules do not apply to them. -->
    <AnalysisLevel>none</AnalysisLevel>
    <EnforceCodeStyleInBuild>false</EnforceCodeStyleInBuild>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\PaperDotNet.Core.Host\PaperDotNet.Core.Host.csproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" PrivateAssets="all" />
  </ItemGroup>
</Project>
