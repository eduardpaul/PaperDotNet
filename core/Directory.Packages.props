<Project>
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <CentralPackageTransitivePinningEnabled>true</CentralPackageTransitivePinningEnabled>
    <EfVersion>11.0.0-rc.1.26425.128</EfVersion>
    <AspNetVersion>11.0.0-rc.1.26425.128</AspNetVersion>
    <WolverineVersion>6.43.0</WolverineVersion>
  </PropertyGroup>
  <!-- Every package must pass docs/dependency-licenses.md. Only what runs under Native AOT (ADR-0039). -->
  <ItemGroup Label="Data">
    <PackageVersion Include="Microsoft.EntityFrameworkCore" Version="$(EfVersion)" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Relational" Version="$(EfVersion)" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Sqlite" Version="$(EfVersion)" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Design" Version="$(EfVersion)" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Tasks" Version="$(EfVersion)" />
  </ItemGroup>
  <ItemGroup Label="Messaging">
    <PackageVersion Include="WolverineFx" Version="$(WolverineVersion)" />
    <PackageVersion Include="WolverineFx.EntityFrameworkCore" Version="$(WolverineVersion)" />
    <PackageVersion Include="WolverineFx.Sqlite" Version="$(WolverineVersion)" />
  </ItemGroup>
  <ItemGroup Label="Web">
    <PackageVersion Include="Microsoft.AspNetCore.OpenApi" Version="$(AspNetVersion)" />
    <PackageVersion Include="Microsoft.Extensions.ApiDescription.Server" Version="$(AspNetVersion)" />
    <!-- Only the URI parser: $filter/$orderby syntax, translated to SQL by us (no ASP.NET Core OData). -->
    <PackageVersion Include="Microsoft.OData.Core" Version="9.0.0" />
  </ItemGroup>
  <ItemGroup Label="Tests">
    <PackageVersion Include="xunit.v3.mtp-v2" Version="4.0.1" />
    <PackageVersion Include="Microsoft.AspNetCore.Mvc.Testing" Version="$(AspNetVersion)" />
  </ItemGroup>
</Project>
