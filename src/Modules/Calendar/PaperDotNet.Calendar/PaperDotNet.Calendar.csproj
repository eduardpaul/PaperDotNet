<Project Sdk="Microsoft.NET.Sdk">
  <!--
    Calendar (CAL-01…04): the event content type and Calendar template, repeating events with exceptions in their time
    zone, time ranges across calendars and task lists, iCalendar export/import and feeds, event reminders. Uses other
    modules only through their contracts.
  -->
  <Import Project="..\..\AotModule.props" />
  <ItemGroup>
    <ProjectReference Include="..\..\Lists\PaperDotNet.Lists.Contracts\PaperDotNet.Lists.Contracts.csproj" />
    <ProjectReference Include="..\..\Identity\PaperDotNet.Identity.Contracts\PaperDotNet.Identity.Contracts.csproj" />
    <ProjectReference Include="..\..\Jobs\PaperDotNet.Jobs.Contracts\PaperDotNet.Jobs.Contracts.csproj" />
    <ProjectReference Include="..\..\Notifications\PaperDotNet.Notifications.Contracts\PaperDotNet.Notifications.Contracts.csproj" />
  </ItemGroup>
  <ItemGroup>
    <!-- iCalendar (RFC 5545). Creates its types by reflection: the host roots the assembly for the trimmer (ADR-0039). -->
    <PackageReference Include="Ical.Net" />
  </ItemGroup>
</Project>
