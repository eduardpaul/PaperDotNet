<Project Sdk="Microsoft.NET.Sdk">
  <!--
    Workflows (ADR-0036, ADR-0039 slice): flows of nodes connected by outcome ports, item and manual triggers, runs
    driven by Wolverine messages, JavaScript script steps in a Jint sandbox (ADR-0037).
  -->
  <Import Project="..\..\AotModule.props" />
  <ItemGroup>
    <ProjectReference Include="..\PaperDotNet.Workflows.Contracts\PaperDotNet.Workflows.Contracts.csproj" />
    <ProjectReference Include="..\..\Lists\PaperDotNet.Lists.Contracts\PaperDotNet.Lists.Contracts.csproj" />
    <ProjectReference Include="..\..\Identity\PaperDotNet.Identity.Contracts\PaperDotNet.Identity.Contracts.csproj" />
    <ProjectReference Include="..\..\Provisioning\PaperDotNet.Provisioning.Contracts\PaperDotNet.Provisioning.Contracts.csproj" />
    <ProjectReference Include="..\..\Jobs\PaperDotNet.Jobs.Contracts\PaperDotNet.Jobs.Contracts.csproj" />
    <ProjectReference Include="..\..\Taxonomy\PaperDotNet.Taxonomy.Contracts\PaperDotNet.Taxonomy.Contracts.csproj" />
    <ProjectReference Include="..\..\Notifications\PaperDotNet.Notifications.Contracts\PaperDotNet.Notifications.Contracts.csproj" />
    <ProjectReference Include="..\..\Collaboration\PaperDotNet.Collaboration.Contracts\PaperDotNet.Collaboration.Contracts.csproj" />
  </ItemGroup>
  <ItemGroup>
    <!-- Script steps: sandboxed JavaScript; runs under Native AOT without .NET interop (ADR-0039). -->
    <PackageReference Include="Jint" />
    <!-- Schedule triggers (cron), as the job scheduler (Jobs). -->
    <PackageReference Include="Cronos" />
  </ItemGroup>
</Project>
