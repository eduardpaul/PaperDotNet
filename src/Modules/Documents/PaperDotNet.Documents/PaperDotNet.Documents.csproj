<Project Sdk="Microsoft.NET.Sdk">
  <!--
    Documents (DMS): files in libraries, file versions, deduplicated storage; text, page images and OCR as built-in
    library workflows (ADR-0038). Uses other modules only through their contracts.
  -->
  <Import Project="..\..\AotModule.props" />
  <ItemGroup>
    <ProjectReference Include="..\..\Lists\PaperDotNet.Lists.Contracts\PaperDotNet.Lists.Contracts.csproj" />
    <ProjectReference Include="..\..\Identity\PaperDotNet.Identity.Contracts\PaperDotNet.Identity.Contracts.csproj" />
    <ProjectReference Include="..\..\Jobs\PaperDotNet.Jobs.Contracts\PaperDotNet.Jobs.Contracts.csproj" />
    <ProjectReference Include="..\..\Workflows\PaperDotNet.Workflows.Contracts\PaperDotNet.Workflows.Contracts.csproj" />
    <ProjectReference Include="..\..\Provisioning\PaperDotNet.Provisioning.Contracts\PaperDotNet.Provisioning.Contracts.csproj" />
  </ItemGroup>
  <ItemGroup>
    <!-- Text layers (PdfPig), page images (PDFium through PDFtoImage, SkiaSharp; native libraries next to the binary), the Tesseract CLI. -->
    <PackageReference Include="PdfPig" />
    <PackageReference Include="PDFtoImage" />
    <PackageReference Include="CliWrap" />
  </ItemGroup>
  <ItemGroup>
    <!-- Page operations (DOC-05/06). -->
    <PackageReference Include="PDFsharp" />
  </ItemGroup>
  <ItemGroup>
    <!-- Still to port (ADR-0039): the MCP document tools (T16). -->
    <Compile Remove="Features/DocumentTools.cs" />
    <None Include="Features/DocumentTools.cs" />
  </ItemGroup>
</Project>
