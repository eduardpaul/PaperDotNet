<Project Sdk="Microsoft.NET.Sdk">
  <!--
    AI providers (P6, ADR-0027): Microsoft.Extensions.AI abstractions, created from configuration. Off by default.
    The OpenAI SDK and its Microsoft.Extensions.AI adapter are trim and AOT compatible (ADR-0039).
  -->
  <PropertyGroup>
    <IsAotCompatible>true</IsAotCompatible>
  </PropertyGroup>
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <PackageReference Include="Microsoft.Extensions.AI" />
    <PackageReference Include="Microsoft.Extensions.AI.OpenAI" />
  </ItemGroup>
  <ItemGroup>
    <!-- The batch API client implements the workflows' contract for batched AI (AI-08). -->
    <ProjectReference Include="..\..\Modules\Workflows\PaperDotNet.Workflows.Contracts\PaperDotNet.Workflows.Contracts.csproj" />
  </ItemGroup>
</Project>
