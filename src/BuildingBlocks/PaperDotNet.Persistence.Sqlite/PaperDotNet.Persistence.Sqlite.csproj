<Project Sdk="Microsoft.NET.Sdk">
  <!--
    SQLite database provider (the default and, under Native AOT, the database of this build: ADR-0039). The only project
    allowed to reference SQLite packages. Schema/ holds the SQL of every module's migrations (eng/schema.sh).
  -->
  <PropertyGroup>
    <IsAotCompatible>true</IsAotCompatible>
  </PropertyGroup>
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <ProjectReference Include="..\PaperDotNet.Persistence\PaperDotNet.Persistence.csproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" />
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Include="Schema\*.sql" LogicalName="Schema.%(Filename).sql" />
  </ItemGroup>
</Project>
