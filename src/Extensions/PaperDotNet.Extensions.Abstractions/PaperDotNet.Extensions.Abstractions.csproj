<Project Sdk="Microsoft.NET.Sdk">
  <!--
    The extension SDK: everything an extension may use. Versioned with SemVer (ExtensionSdk.Version);
    breaking changes need a new major version. Extensions reference only this package (ADR-0014).
  -->
  <PropertyGroup>
    <RootNamespace>PaperDotNet.Extensions</RootNamespace>
    <PackageId>PaperDotNet.Extensions.Abstractions</PackageId>
  </PropertyGroup>
  <PropertyGroup>
    <IsAotCompatible>true</IsAotCompatible>
  </PropertyGroup>
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <ProjectReference Include="..\..\BuildingBlocks\PaperDotNet.Abstractions\PaperDotNet.Abstractions.csproj" />
    <ProjectReference Include="..\..\BuildingBlocks\PaperDotNet.Api\PaperDotNet.Api.csproj" />
    <ProjectReference Include="..\..\Modules\Lists\PaperDotNet.Lists.Contracts\PaperDotNet.Lists.Contracts.csproj" />
    <ProjectReference Include="..\..\Modules\Jobs\PaperDotNet.Jobs.Contracts\PaperDotNet.Jobs.Contracts.csproj" />
    <ProjectReference Include="..\..\Modules\Workspaces\PaperDotNet.Workspaces.Contracts\PaperDotNet.Workspaces.Contracts.csproj" />
    <ProjectReference Include="..\..\Modules\Identity\PaperDotNet.Identity.Contracts\PaperDotNet.Identity.Contracts.csproj" />
    <ProjectReference Include="..\..\Modules\Workflows\PaperDotNet.Workflows.Contracts\PaperDotNet.Workflows.Contracts.csproj" />
  </ItemGroup>
  <ItemGroup>
    <!--
      Extension tables come back with T09b (compiled model and precompiled queries per extension); term sets, template
      sections, shipped workflows and MCP tools with their modules (docs/aot-porting-plan.md).
    -->
    <Compile Remove="ExtensionDbContext.cs" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="PaperDotNet.UnitTests" />
  </ItemGroup>
  <!-- The package carries the extension analyzers (EXT-05), so every extension project gets them. -->
  <ItemGroup>
    <ProjectReference Include="..\PaperDotNet.Extensions.Analyzers\PaperDotNet.Extensions.Analyzers.csproj" ReferenceOutputAssembly="false" PrivateAssets="all" />
  </ItemGroup>
  <PropertyGroup>
    <TargetsForTfmSpecificContentInPackage>$(TargetsForTfmSpecificContentInPackage);PackExtensionAnalyzers</TargetsForTfmSpecificContentInPackage>
  </PropertyGroup>
  <Target Name="PackExtensionAnalyzers">
    <MSBuild Projects="..\PaperDotNet.Extensions.Analyzers\PaperDotNet.Extensions.Analyzers.csproj" Targets="GetTargetPath" Properties="Configuration=$(Configuration)" RemoveProperties="TargetFramework">
      <Output TaskParameter="TargetOutputs" ItemName="_ExtensionAnalyzer" />
    </MSBuild>
    <ItemGroup>
      <TfmSpecificPackageFile Include="@(_ExtensionAnalyzer)" PackagePath="analyzers/dotnet/cs" />
    </ItemGroup>
  </Target>
</Project>
