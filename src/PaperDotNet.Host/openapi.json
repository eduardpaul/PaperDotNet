  "components": {
    "schemas": {
      "ActivityDto": {
        "required": [
          "key",
          "description",
          "outcomes"
        ],
        "type": "object",
        "properties": {
          "key": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "outcomes": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      },
      "AuditEntryDto": {
        "required": [
          "id",
          "action",
          "targetId",
          "listId",
          "userId",
          "summary",
          "occurredAt"
        ],
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "action": {
            "type": "string"
          },
          "targetId": {
            "type": "string",
            "format": "uuid"
          },
          "listId": {
            "type": [
              "null",
              "string"
            ],
            "format": "uuid"
          },
          "userId": {
            "type": [
              "null",
              "string"
            ],
            "format": "uuid"
          },
          "summary": {
            "type": [
              "null",
              "string"
            ]
          },
          "occurredAt": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "CreateItemRequest": {
        "required": [
          "fields"
        ],
        "type": "object",
        "properties": {
          "fields": {
            "$ref": "#/components/schemas/JsonObject"
          }
        },
        "description": "New item: `fields` holds the title and the other field values."
      },
      "CreateListRequest": {
        "required": [
          "name",
          "description",
          "fields"
        ],
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "description": {
            "type": [
              "null",
              "string"
            ]
          },
          "fields": {
            "type": [
              "null",
              "array"
            ],
            "items": {
              "$ref": "#/components/schemas/FieldDefinition"
            }
          }
        }
      },
      "CreateUserRequest": {
        "required": [
          "userName",
          "password",
          "displayName"
        ],
        "type": "object",
