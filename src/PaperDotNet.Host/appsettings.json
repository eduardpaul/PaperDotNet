{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ForwardedHeaders": {
    "Enabled": false
  },
  "ConnectionStrings": {
    "PaperDotNet": ""
  },
  "Database": {
    "Provider": "Sqlite",
    "MigrateOnStartup": true
  },
  "Storage": {
    "DataPath": "data"
  },
  "StorageOptimization": {
    "TextDetector": "paddleocr",
    "PaddleThreads": 1,
    "MaxPixels": 64000000,
    "OcrTimeoutSeconds": 120
  },
  "Tenancy": {
    "DefaultTenant": "default",
    "HostTemplate": "",
    "AllowHeader": false,
    "HeaderName": "X-Tenant"
  },
  "Auth": {
    "AccessTokenLifetime": "01:00:00",
    "RefreshTokenLifetime": "14.00:00:00",
    "RequireHttps": true,
    "AllowPasswordGrant": true,
    "LoginUrl": "",
    "FirstPartyRedirectUris": [],
    "PasskeyServerDomain": "",
    "PasskeyOrigins": []
  },
  "Bootstrap": {
    "TenantIdentifier": "default",
    "TenantName": "Default",
    "AdminUserName": "admin",
    "AdminPassword": ""
  }
}
