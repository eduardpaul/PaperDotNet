<Project>
  <PropertyGroup>
    <TargetFramework>net11.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <AnalysisLevel>latest-recommended</AnalysisLevel>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <!-- CS1591: missing XML comments. Public API docs are added where they matter. -->
    <NoWarn>$(NoWarn);CS1591</NoWarn>
    <Deterministic>true</Deterministic>
    <!-- Compile configuration binding instead of reflecting over options types. -->
    <EnableConfigurationBindingGenerator>true</EnableConfigurationBindingGenerator>
    <!-- The server is one Native AOT binary (ADR-0039): no culture data needed. -->
    <InvariantGlobalization>true</InvariantGlobalization>
    <!-- No localized satellite assemblies (System.CommandLine ships some): their cultures do not exist in invariant
         mode, and Wolverine's assembly scan fails on them. -->
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <Authors>Eduard Paul</Authors>
    <Copyright>Copyright 2026 Eduard Paul</Copyright>
    <PackageLicenseExpression>Apache-2.0</PackageLicenseExpression>
    <Version>0.2.0</Version>
  </PropertyGroup>
</Project>
